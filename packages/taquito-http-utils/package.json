{
  "name": "@taquito/http-utils",
  "version": "25.1.2",
  "description": "HTTP transport utilities for Taquito RPC clients with retry, timeout, and error classification.",
  "keywords": [
    "taquito",
    "tezos",
    "typescript",
    "http",
    "rpc",
    "fetch",
    "retry",
    "transport"
  ],
  "main": "dist/lib/taquito-http-utils.js",
  "module": "dist/taquito-http-utils.es6.js",
  "typings": "dist/types/taquito-http-utils.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/taquito-http-utils.d.ts",
      "browser": "./dist/taquito-http-utils.es6.js",
      "import": "./dist/taquito-http-utils.mjs",
      "require": "./dist/lib/taquito-http-utils.js"
    },
    "./package.json": "./package.json",
    "./README.md": "./README.md",
    "./dist/*.js": "./dist/*.js",
    "./dist/*.mjs": "./dist/*.mjs",
    "./dist/*.map": "./dist/*.map",
    "./dist/*.d.ts": "./dist/*.d.ts",
    "./dist/*.json": "./dist/*.json",
    "./dist/*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "files": [
    "dist"
  ],
  "author": "ECAD Labs Inc <info@ecadlabs.com>",
  "contributors": [
    "Jev Bj\u00f6rsell (jevonearth)",
    "Davis Sawali <davis.sawali@ecadlabs.com>",
    "Roxane Letourneau <roxane@ecadlabs.com>",
    "Simon Boissonneault-Robert <simon@ecadlabs.com>"
  ],
  "homepage": "https://taquito.io/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ecadlabs/taquito.git"
  },
  "bugs": {
    "url": "https://github.com/ecadlabs/taquito/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint": "eslint --ext .js,.ts .",
    "precommit": "lint-staged",
    "prebuild": "rimraf dist",
    "version-stamp": "node ../taquito/version-stamping.js",
    "build": "tsc --project ./tsconfig.prod.json --module commonjs && rollup -c rollup.config.ts --bundleConfigAsCjs",
    "start": "rollup -c rollup.config.ts --bundleConfigAsCjs -w",
    "test": "vitest run --config ./vitest.config.ts"
  },
  "lint-staged": {
    "{src,test}/**/*.ts": [
      "prettier --write",
      "eslint --fix"
    ]
  },
  "dependencies": {
    "@taquito/core": "^25.1.2"
  },
  "devDependencies": {
    "@rollup/plugin-json": "^6.1.0",
    "@types/node": "^22.20.5",
    "eslint": "^10.15.0",
    "lint-staged": "^15.2.7",
    "prettier": "^3.9.10",
    "rimraf": "^6.1.3",
    "rollup": "^4.67.3",
    "rollup-plugin-typescript2": "^0.37.0",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3"
  },
  "gitHead": "551e35aeff7d6dcde1c72284238c0ed3c3aae77e"
}
